# Production values live in the committed .env.production (public URL + anon key only). Use .env for local overrides.
# Without these the auditor and forms still work in the browser, but nothing is saved (the build check fails).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Optional newsletter subscribe page (e.g. https://tonnagecheck.beehiiv.com/subscribe). Email is passed as ?email=
PUBLIC_NEWSLETTER_URL=
