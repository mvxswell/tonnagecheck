---
import { SITE } from '../config';
// idp keeps element IDs unique when a page shows this form twice (inside the auditor and standalone).
interface Props { standalone?: boolean; idp?: string; brandModel?: string }
const { standalone = false, idp = 'c', brandModel = '' } = Astro.props;
---
<form class="cform" data-standalone={standalone ? '1' : undefined} novalidate>
  <h2>Get a second opinion from an independent master tech</h2>
  <p class="muted">Tell us about the quote you got. We pass your request to an independent, owner-operated HVAC company (1–5 trucks) that serves your ZIP. No private-equity "comfort advisors," no pressure. Free for homeowners.</p>
  <div class="cgrid">
    <div><label for={idp + '-name'}>Name</label><input id={idp + '-name'} name="name" required maxlength="120" autocomplete="name" /></div>
    <div><label for={idp + '-email'}>Email</label><input id={idp + '-email'} name="email" type="email" required maxlength="254" autocomplete="email" /></div>
    <div><label for={idp + '-phone'}>Phone <span class="muted small">(optional)</span></label><input id={idp + '-phone'} name="phone" type="tel" maxlength="40" autocomplete="tel" /></div>
    <div><label for={idp + '-zip'}>ZIP code</label><input id={idp + '-zip'} name="zip" inputmode="numeric" maxlength="5" required autocomplete="postal-code" /></div>
    <div><label for={idp + '-quoted'}>Quote you received ($)</label><input id={idp + '-quoted'} name="quoted" inputmode="decimal" maxlength="12" /></div>
    <div><label for={idp + '-bm'}>Brand / model quoted</label><input id={idp + '-bm'} name="brandModel" maxlength="160" placeholder="e.g. Carrier 3-ton 16 SEER2" value={brandModel || undefined} /></div>
    <div class="c2">
      <label for={idp + '-time'}>Timeline</label>
      <select id={idp + '-time'} name="timeline">
        <option value="asap">ASAP (system down or failing)</option>
        <option value="2-4-weeks" selected>Within 2–4 weeks</option>
        <option value="1-3-months">1–3 months</option>
        <option value="researching">Just researching</option>
      </select>
    </div>
    <div class="c2"><label for={idp + '-notes'}>Anything else? <span class="muted small">(optional)</span></label><textarea id={idp + '-notes'} name="notes" rows="3" maxlength="2000" placeholder="House size, current system, what the contractor recommended..."></textarea></div>
  </div>
  <label class="check small agree"><input type="checkbox" name="agree" required />I agree that TonnageCheck may share these details with up to two independent installers serving my ZIP so they can contact me about a quote.</label>
  <p class="cerr small" role="alert" hidden></p>
  <button class="btn" type="submit">Request my independent quote</button>
  <div class="cdone" hidden role="status"></div>
</form>

<style>
.cform h2{margin-top:0}
.cgrid{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr));margin:12px 0}
.cgrid .c2{grid-column:1/-1}
.agree{align-items:flex-start;margin:6px 0 12px;font-weight:500}
.agree input{margin-top:4px}
.cerr{color:var(--bad);font-weight:600}
.cdone{margin-top:12px;background:var(--okbg);border-radius:10px;padding:12px 14px}
@media (max-width:560px){.cgrid{grid-template-columns:1fr}}
</style>

<script define:vars={{ contactEmail: SITE.contactEmail }}>
  window.__tcContact = contactEmail;
</script>

<script>
  import { rpc } from '../lib/supabase';
  import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../config';

  for (const form of document.querySelectorAll<HTMLFormElement>('form.cform')) {
    const errEl = form.querySelector('.cerr') as HTMLElement;
    const done = form.querySelector('.cdone') as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) || '').trim();
      const problems: string[] = [];
      if (!v('name')) problems.push('Add your name.');
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v('email'))) problems.push('Add a valid email.');
      if (!/^\d{5}$/.test(v('zip'))) problems.push('Add a 5-digit ZIP.');
      if (!f.has('agree')) problems.push('Tick the consent box so we can pass your request on.');
      errEl.hidden = !problems.length;
      errEl.textContent = problems.join(' ');
      if (problems.length) return;

      const quoted = parseFloat(v('quoted').replace(/[$,\s]/g, ''));
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      const res = await rpc(SUPABASE_URL, SUPABASE_ANON_KEY, 'request_independent_quote', {
        p_name: v('name'), p_email: v('email'), p_phone: v('phone') || null, p_zip_code: v('zip'),
        p_quoted_amount_usd: isFinite(quoted) ? quoted : null, p_quoted_brand_model: v('brandModel') || null,
        p_timeline: v('timeline'), p_notes: v('notes') || null,
      });
      btn.disabled = false;
      if (res.ok) {
        done.innerHTML = '<b>Got it.</b> An independent installer serving your ZIP will reach out to you directly. Keep your current quote handy and don\'t sign anything under deadline pressure.';
        done.hidden = false;
        btn.hidden = true;
        return;
      }
      // Not saved (no backend configured, or an error): hand the request to the user's mail app instead.
      const contact = (window as any).__tcContact as string;
      const body = [`Name: ${v('name')}`, `Email: ${v('email')}`, `Phone: ${v('phone')}`, `ZIP: ${v('zip')}`, `Quote: ${v('quoted')}`, `Brand/model: ${v('brandModel')}`, `Timeline: ${v('timeline')}`, `Notes: ${v('notes')}`].join('\n');
      const href = `mailto:${contact}?subject=${encodeURIComponent('Independent quote request ' + v('zip'))}&body=${encodeURIComponent(body)}`;
      done.innerHTML = `${res.skipped ? 'Online matching isn\'t switched on yet.' : 'We couldn\'t save that just now (' + String(res.error).replace(/[<>&]/g, '') + ').'} <a href="${href}">Send the same request by email</a> and we'll take it from there.`;
      done.hidden = false;
    });
  }
</script>
