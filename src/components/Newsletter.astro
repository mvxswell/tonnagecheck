---
import { NEWSLETTER_URL, SITE } from '../config';
---
<section class="card nl" id="newsletter" aria-labelledby="nl-h">
  <h2 id="nl-h">The weekly Quote Red-Flag Report</h2>
  <p class="muted">One email a week for homeowners: which rebates are actually open, real quotes we've graded (anonymized), and the upsell tricks to watch for. Free, no spam, unsubscribe anytime.</p>
  <form class="nlform" data-url={NEWSLETTER_URL} data-contact={SITE.contactEmail} novalidate>
    <label for="nl-email" class="sr">Email address</label>
    <input id="nl-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
    <button class="btn" type="submit">Subscribe</button>
  </form>
  <p class="nlmsg small" role="status" hidden></p>
</section>

<style>
.nl{margin-top:32px;background:linear-gradient(180deg,#fff,#f3f8fc)}
.nl h2{margin-top:0}
.nlform{display:flex;gap:8px;flex-wrap:wrap}
.nlform input{flex:1 1 220px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.nlmsg{margin:10px 0 0}
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.nlform')) {
    const msg = form.parentElement!.querySelector('.nlmsg') as HTMLElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = String(new FormData(form).get('email') || '').trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { msg.textContent = 'Please enter a valid email.'; msg.hidden = false; return; }
      const url = form.dataset.url;
      if (url) {
        // Hosted subscribe page (e.g. beehiiv) with the address pre-filled; nothing is stored by TonnageCheck itself.
        window.open(`${url}${url.includes('?') ? '&' : '?'}email=${encodeURIComponent(email)}`, '_blank', 'noopener');
        msg.textContent = 'Opening the subscribe page in a new tab. Confirm there and you are in.';
      } else {
        const href = `mailto:${form.dataset.contact}?subject=${encodeURIComponent('Subscribe me to the Quote Red-Flag Report')}&body=${encodeURIComponent('Please add ' + email + ' to the weekly newsletter.')}`;
        msg.innerHTML = `The newsletter launches soon. <a href="${href}">Email us to get on the list</a>.`;
      }
      msg.hidden = false;
    });
  }
</script>
