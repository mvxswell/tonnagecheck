---
import { SITE } from '../config';
interface Props { title: string; description: string; jsonld?: object | object[]; noindex?: boolean }
const { title, description, jsonld, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// PNG, not SVG: X, iMessage and Facebook do not render SVG link previews. public/og-image.png is rendered from og-image.svg.
const ogImage = new URL('/og-image.png', Astro.site).href;
const ogAlt = 'TonnageCheck: Is your HVAC or heat pump quote fair? Real listed equipment prices, DOE-lab benchmarks, A–F grade';
const path = Astro.url.pathname;
const nav = [
  ['/auditor/', 'Quote auditor'],
  ['/calculator/', 'Cost calculator'],
  ['/tonnage/', 'By tonnage'],
  ['/states/', 'By state'],
  ['/systems/', 'Equipment prices'],
  ['/parts/', 'Parts & add-ons'],
  ['/brands/', 'Brands'],
  ['/compare/', 'Compare'],
  ['/guides/', 'Guides'],
  ['/partners/', 'For techs'],
];
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon.svg`,
  description: SITE.description,
};
const ld = [orgLd, ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : [])];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#0f2a3d" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
<link rel="sitemap" href="/sitemap-index.xml" />
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap nav">
    <a href="/" class="logo" aria-label="TonnageCheck home">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#0f2a3d"/><path d="M9 16.5l4.5 4.5L23 11" stroke="#3ddc97" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Tonnage<b>Check</b></span>
    </a>
    <nav aria-label="Main">
      {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<main id="main" class="wrap"><slot /></main>
<footer class="foot">
  <div class="wrap">
    <p><b>Rule #1: no made-up numbers.</b> Equipment prices are public online listings (HVACDirect, Alpine Home Air) captured on the date shown. Efficiency ratings come from the EPA ENERGY STAR database or the listing. Installed-cost ranges are DOE national-lab benchmarks (REMDB), clearly marked as estimates. TonnageCheck is independent and is not affiliated with any manufacturer, retailer, or contractor.</p>
    <p class="links"><a href="/about/">Methodology &amp; sources</a> · <a href="/calculator/">Cost calculator</a> · <a href="/parts/">Parts &amp; add-ons</a> · <a href="/compare/">Comparisons</a> · <a href="/guides/">Guides</a> · <a href="/partners/">Independent techs</a> · <a href="/privacy/">Privacy</a> · <a href="/sitemap-index.xml">Sitemap</a> · <a href="/llms.txt">llms.txt</a></p>
    <p class="muted small">© {new Date().getFullYear()} {SITE.name}. Not financial, tax, or engineering advice. Always get a Manual J load calculation and the AHRI certificate for the exact equipment you are quoted.</p>
  </div>
</footer>
<style is:global>
:root{
  --ink:#0f1c26;--mut:#546474;--bg:#f5f7f9;--card:#fff;--line:#dde3e9;--navy:#0f2a3d;--acc:#0b6bcb;--acc2:#3ddc97;
  --ok:#0a7a4f;--okbg:#e5f6ee;--warn:#9a5b00;--warnbg:#fff4e0;--bad:#b42318;--badbg:#fdecea;
  --mono:ui-monospace,"SF Mono","Cascadia Mono","Roboto Mono",Menlo,Consolas,monospace;
}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg)}
a{color:var(--acc)}a:hover{text-decoration-thickness:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 16px}
.skip{position:absolute;left:-9999px}.skip:focus{left:8px;top:8px;background:#fff;padding:8px;z-index:10}
.top{background:var(--navy);position:sticky;top:0;z-index:5}
.nav{display:flex;align-items:center;justify-content:space-between;min-height:56px;gap:8px 16px;flex-wrap:wrap;padding:6px 16px}
.logo{display:flex;align-items:center;gap:8px;color:#fff;text-decoration:none;font-weight:600;font-size:1.08rem;letter-spacing:-.01em}
.logo b{color:var(--acc2)}
nav{display:flex;flex-wrap:wrap;gap:2px 14px}
nav a{color:#cfdbe5;text-decoration:none;font-weight:600;font-size:.94rem;padding:4px 0}
nav a:hover,nav a[aria-current]{color:#fff;box-shadow:inset 0 -2px 0 var(--acc2)}
h1{font-size:clamp(1.65rem,4.4vw,2.45rem);line-height:1.15;margin:.5em 0 .3em;letter-spacing:-.02em}
h2{font-size:1.32rem;margin:1.8em 0 .55em;letter-spacing:-.01em}h3{font-size:1.06rem;margin:1.2em 0 .4em}
.lead{font-size:1.1rem;color:var(--mut);max-width:740px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
.muted{color:var(--mut)}.small{font-size:.875rem}
.num,.tabnum{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.badge{display:inline-block;font-size:.76rem;font-weight:700;border-radius:999px;padding:2px 10px;letter-spacing:.02em;text-transform:uppercase;white-space:nowrap}
.b-fair{background:var(--okbg);color:var(--ok)}.b-over{background:var(--warnbg);color:var(--warn)}.b-red{background:var(--badbg);color:var(--bad)}
.b-est{background:#eef1f5;color:#4a5866;text-transform:none;font-weight:600}
.b-es{background:#e3f0fb;color:#0b5394;text-transform:none}
.btn{display:inline-block;background:var(--acc);color:#fff;border:0;border-radius:10px;padding:11px 18px;font-weight:700;text-decoration:none;cursor:pointer;font-size:1rem;line-height:1.2}
.btn:hover{background:#0957a6}.btn.alt{background:var(--navy)}.btn.ghost{background:transparent;color:var(--acc);border:1.5px solid var(--acc)}
.btn:disabled{opacity:.6;cursor:wait}
label{font-weight:600;font-size:.92rem;display:block;margin-bottom:4px}
input,select,textarea{font:inherit;width:100%;padding:10px 12px;border:1px solid #c5cfd8;border-radius:9px;background:#fff;color:var(--ink)}
input:focus,select:focus,textarea:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
input[type=checkbox]{width:auto;margin-right:8px}
.check{display:flex;align-items:center;font-weight:500}
table{width:100%;border-collapse:collapse;font-size:.92rem}
th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--mut);font-weight:600;font-size:.82rem;text-transform:uppercase;letter-spacing:.03em}
td.r,th.r{text-align:right}
.tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--line);border-radius:12px;background:#fff}
.tablewrap table td,.tablewrap table th{white-space:nowrap}
.note{background:#f0f4f8;border-left:3px solid var(--acc);padding:10px 14px;border-radius:6px;font-size:.92rem}
.warnbox{background:var(--warnbg);border:1px solid #f1cf94;border-radius:10px;padding:12px 14px}
.crumbs{font-size:.86rem;color:var(--mut);margin-top:16px}.crumbs a{color:var(--mut)}
.prose{max-width:740px}.prose p,.prose li{font-size:1.04rem}
.foot{border-top:1px solid var(--line);margin-top:56px;padding:26px 0;color:var(--mut);font-size:.9rem;background:#fff}
.foot .links a{color:var(--ink)}
@media (max-width:640px){nav{gap:2px 12px}nav a{font-size:.88rem}.card{padding:14px}}
</style>
</body>
</html>
