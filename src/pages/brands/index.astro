---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { BRANDS } from '../../data/brands';
import { SYSTEMS, SYSTEM_TYPE_LABEL, lowestPrice } from '../../data/equipment';
import { fairRange, usd, fmtRange, seedDateLabel } from '../../lib/facts';
import { SITE } from '../../config';
const shortType: Record<string, string> = { 'central-heat-pump': 'ducted heat pump', 'mini-split': 'mini-split', 'ac-furnace': 'AC + furnace', 'heat-pump-only': 'condenser' };
const minEq = Math.min(...SYSTEMS.map(lowestPrice));
const maxEq = Math.max(...SYSTEMS.map(lowestPrice));
const f3 = fairRange('central-heat-pump', 3);
const title = `${usd(minEq)}–${usd(maxEq)} Equip vs ${fmtRange(f3)} Installed: Brands`;
const description = `Compare ${BRANDS.length} HVAC brands (${SYSTEMS.length} systems from ${usd(minEq)} to ${usd(maxEq)} equipment vs ${fmtRange(f3)} 3-ton installed benchmark): Goodman, Trane, Bosch, Mitsubishi & more.`;
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'HVAC brands with listed equipment prices',
  itemListElement: BRANDS.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: `${b.name} HVAC prices`, url: `${SITE.url}/brands/${b.slug}/` })),
};
---
<Base title={title} description={description} jsonld={ld}>
  <p class="crumbs"><a href="/">Home</a> / Brands</p>
  <h1>HVAC brands: listed prices vs installed benchmarks</h1>
  <p class="lead">Every brand below has real listings with sourced prices (captured {seedDateLabel}). Pick a brand to see its equipment price span by size next to what installation should cost, then audit a quote for that brand.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>Brand</th><th class="r">Systems</th><th>Sizes (tons)</th><th>Types</th><th class="r">Listed equipment</th><th class="r">SEER2</th><th class="r">ENERGY STAR matched</th></tr></thead>
      <tbody>
        {BRANDS.map((b) => (
          <tr>
            <td><a href={`/brands/${b.slug}/`}><b>{b.name}</b></a></td>
            <td class="r num">{b.systems.length}</td>
            <td class="num">{b.tonnages.join(', ')}</td>
            <td>{b.types.map((t) => shortType[t]).join(', ')}</td>
            <td class="r num">{usd(b.priceMin)}–{usd(b.priceMax)}</td>
            <td class="r num">{b.seer2Min === b.seer2Max ? b.seer2Min : `${b.seer2Min}–${b.seer2Max}`}</td>
            <td class="r num">{b.energyStarCount}{b.coldClimateCount > 0 && <span class="small muted"> ({b.coldClimateCount} cold-climate)</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted">Only brands with live, verifiable listings appear. Listed prices are public online retail for the equipment only. Types: {Object.values(SYSTEM_TYPE_LABEL).join(' · ')}.</p>
  <p><a class="btn" href="/auditor/">Audit a quote for any brand</a></p>
  <Newsletter />
</Base>
