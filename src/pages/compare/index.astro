---
import Base from '../../layouts/Base.astro';
import CompareWorkbench from '../../components/CompareWorkbench.astro';
import { COMPARISONS } from '../../data/comparisons';
import { isCompareMerged, isCompareIndexed, COMPARE_MERGED } from '../../data/prune';
import { SYSTEMS, lowestPrice } from '../../data/equipment';
import { statsOf, systemsWhere, usd, seedDateLabel } from '../../lib/facts';
import QuoteCta from '../../components/QuoteCta.astro';

const allStats = statsOf(SYSTEMS)!;
const live = COMPARISONS.filter((c) => !isCompareMerged(c.slug));
const more = live.filter((c) => !isCompareIndexed(c.slug));

const moneyExact = (n: number) => {
  const cents = Math.round(n * 100) / 100;
  const hasCents = !Number.isInteger(cents);
  return `$${cents.toLocaleString('en-US', { minimumFractionDigits: hasCents ? 2 : 0, maximumFractionDigits: 2 })}`;
};
const meanOf = (xs: typeof SYSTEMS) => xs.reduce((sum, s) => sum + lowestPrice(s), 0) / xs.length;

const hp = systemsWhere({ type: 'central-heat-pump' });
const ms = systemsWhere({ type: 'mini-split' });
const acf = systemsWhere({ type: 'ac-furnace' });
const cond = systemsWhere({ type: 'heat-pump-only' });
const hpMed = statsOf(hp).median!;
const msMed = statsOf(ms).median!;
const acfMean = meanOf(acf);
const acfMed = statsOf(acf).median!;
const condMed = statsOf(cond).median!;

const folded = [
  { href: '/guides/bosch-ids-inverter-heat-pump-cost/', label: 'Bosch vs Mitsubishi', note: 'Bosch IDS inverter cost guide' },
  { href: '/guides/mitsubishi-hyper-heat-cost/', label: 'LG vs Mitsubishi', note: 'Mitsubishi Hyper-Heat guide' },
  { href: '/guides/goodman-vs-trane-vs-carrier-equipment-markup/', label: 'LG vs Trane', note: 'Goodman vs Trane vs Carrier markup guide' },
  { href: '/guides/inverter-vs-single-stage-heat-pump-cost/', label: 'ACiQ vs MRCOOL and inverter vs single-stage', note: 'Inverter vs single-stage guide' },
  { href: '/guides/heat-pump-vs-ac-and-furnace-replacement-cost/', label: 'Heat pump vs AC + furnace, Trane vs Goodman furnaces', note: 'Heat pump vs AC + furnace guide' },
  { href: '/guides/r410a-vs-r454b-r32-refrigerant-transition-quotes/', label: 'R-32 vs R-454B systems', note: 'Refrigerant transition guide' },
  { href: '/guides/3-ton-heat-pump-ac-replacement-cost/', label: 'Cost by size, 1.5 to 5 tons (model matchups included)', note: 'Combined size guide, every size from 1.5 to 5 tons' },
];

const title = `${usd(allStats.min)}–${usd(allStats.max)} HVAC Comparison Workbench`;
const description = `Pick any two of ${SYSTEMS.length} listed HVAC systems and compare equipment prices, SEER2 and DOE installed-cost benchmarks. Saved brand matchups now live in the guides.`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'HVAC equipment comparison workbench',
  description,
  url: 'https://tonnagechecker.com/compare/',
};
---
<Base title={title} description={description} jsonld={jsonld}>
  <p class="crumbs"><a href="/">Home</a> / Comparisons</p>
  <h1>HVAC equipment comparison workbench ({SYSTEMS.length} systems)</h1>
  <p class="lead">This page is the comparison tool: pick any two of the {SYSTEMS.length} listed systems in the workbench below ({seedDateLabel}). It starts on two 3-ton ducted heat pumps that both have ENERGY STAR / AHRI records: the Goodman GLZS5BA3610, certified at 35,400 BTU/h (AHRI #215381162), and the Trane A5HL5036A1000A, certified at 34,000 BTU/h (AHRI #216439108). Saved brand, refrigerant and model matchups now live in the guides listed after the tool.</p>

  <div class="card" style="margin:18px 0">
    <h2 style="margin-top:0">Listed-price snapshot of this catalog</h2>
    <p class="small muted">These catalog-wide figures are computed from the {SYSTEMS.length} public listings on this page ({seedDateLabel}) and are shown only here. The workbench below can pair any two of them.</p>
    <div class="tablewrap">
      <table>
        <thead>
          <tr>
            <th>System type</th>
            <th class="r">Count</th>
            <th class="r">Median listed (equipment only)</th>
            <th class="r">Mean listed (equipment only)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Ducted heat pump</td>
            <td class="r num">{hp.length}</td>
            <td class="r num">{moneyExact(hpMed)}</td>
            <td class="r num">{moneyExact(meanOf(hp))}</td>
          </tr>
          <tr>
            <td>Mini-split</td>
            <td class="r num">{ms.length}</td>
            <td class="r num">{moneyExact(msMed)}</td>
            <td class="r num">{moneyExact(meanOf(ms))}</td>
          </tr>
          <tr>
            <td>AC + furnace</td>
            <td class="r num">{acf.length}</td>
            <td class="r num">{moneyExact(acfMed)}</td>
            <td class="r num">{moneyExact(acfMean)}</td>
          </tr>
          <tr>
            <td>Condenser-only</td>
            <td class="r num">{cond.length}</td>
            <td class="r num">{moneyExact(condMed)}</td>
            <td class="r num">{moneyExact(meanOf(cond))}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <CompareWorkbench />

  <h2>Head-to-head matchups, now in the guides</h2>
  <p class="small muted">The brand, refrigerant and flagship model comparisons now sit inside the guide that answers the same question, with the same sourced prices and ratings. Size-by-size cost and the flagship model matchups live in the <a href="/guides/3-ton-heat-pump-ac-replacement-cost/">combined size guide</a>; the <a href="/tonnage/">tonnage index</a> has the step-up cost from one size to the next.</p>
  <div class="grid">
    {folded.map((f) => (
      <a class="card" href={f.href} style="text-decoration:none;color:inherit">
        <div style="font-weight:700;margin:4px 0;color:var(--acc)">{f.label}</div>
        <div class="small muted">{f.note}</div>
      </a>
    ))}
  </div>

  {more.length > 0 && (
    <>
      <h2>More matchups</h2>
      <p class="small muted">{more.map((c, i) => <>{i > 0 && ' · '}<a href={`/compare/${c.slug}/`}>{c.shortLabel}</a></>)}</p>
    </>
  )}

  <QuoteCta />
</Base>
