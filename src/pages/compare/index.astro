---
import Base from '../../layouts/Base.astro';
import CompareWorkbench from '../../components/CompareWorkbench.astro';
import Auditor from '../../components/Auditor.astro';
import { COMPARISONS } from '../../data/comparisons';
import { isCompareMerged, isCompareIndexed } from '../../data/prune';
import { SYSTEMS } from '../../data/equipment';
import { statsOf, usd, catalogDateLabel } from '../../lib/facts';

const allStats = statsOf(SYSTEMS)!;
// Merged comparisons now live inside guides (301s in public/_redirects); noindexed ones are listed compactly at the end.
const live = COMPARISONS.filter((c) => !isCompareMerged(c.slug));
const featured = live.filter((c) => isCompareIndexed(c.slug));
const more = live.filter((c) => !isCompareIndexed(c.slug));
const brandComparisons = featured.filter((c) => c.category === 'brand');
const typeComparisons = featured.filter((c) => c.category === 'type');
const modelComparisons = featured.filter((c) => c.category === 'model');

const title = `${usd(allStats.min)}–${usd(allStats.max)} HVAC Brand & Tonnage Comparisons`;
const description = `Compare ${live.length} head-to-head HVAC brand, tonnage & model matchups (${usd(allStats.min)}–${usd(allStats.max)} equipment vs DOE installed costs).`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Head-to-Head HVAC Brand, Tonnage & System Comparisons',
  description,
  url: 'https://tonnagechecker.com/compare/',
};
---
<Base title={title} description={description} jsonld={jsonld}>
  <p class="crumbs"><a href="/">Home</a> / Comparisons</p>
  <h1>Head-to-head HVAC brand, tonnage &amp; system comparisons</h1>
  <p class="lead">Compare public distributor equipment prices ({usd(allStats.min)}–{usd(allStats.max)} across {SYSTEMS.length} systems as of {catalogDateLabel}), DOE national-lab installed replacement benchmarks, SEER2/HSPF2 efficiency, refrigerant (R-32 vs R-454B), and contractor markup spreads side by side.</p>

  <CompareWorkbench />

  <h2>Brand-vs-brand HVAC cost &amp; spec comparisons ({brandComparisons.length})</h2>
  <p class="small muted">See how much two brands actually differ in wholesale/online equipment price versus what contractors charge on tiered proposals.</p>
  <div class="grid">
    {brandComparisons.map((c) => (
      <a class="card" href={`/compare/${c.slug}/`} style="text-decoration:none;color:inherit">
        <div class="small muted">{c.shortLabel}</div>
        <div style="font-weight:700;margin:4px 0;color:var(--acc)">{c.h1}</div>
        <p class="small" style="margin:6px 0">
          <b>{c.left.label}:</b> {usd(c.left.equipMin)}–{usd(c.left.equipMax)} (med {usd(c.left.equipMedian)}) · {c.left.seer2Span}<br />
          <b>{c.right.label}:</b> {usd(c.right.equipMin)}–{usd(c.right.equipMax)} (med {usd(c.right.equipMedian)}) · {c.right.seer2Span}
        </p>
      </a>
    ))}
  </div>

  <h2>Sizes and compressor staging</h2>
  <p class="small muted">Size-by-size cost steps are on the <a href="/tonnage/">by-tonnage pages</a>. Single-stage vs inverter cost at 3, 4 and 5 tons is in the <a href="/guides/inverter-vs-single-stage-heat-pump-cost/">inverter vs single-stage guide</a>, and heat pump vs AC + furnace by size is in the <a href="/guides/heat-pump-vs-ac-and-furnace-replacement-cost/">heat pump vs AC + furnace guide</a>.</p>

  <h2>System-type &amp; A2L refrigerant comparisons ({typeComparisons.length})</h2>
  <p class="small muted">R-32 vs R-454B systems compared. Heat pump vs AC + furnace by size is in the <a href="/guides/heat-pump-vs-ac-and-furnace-replacement-cost/">heat pump vs AC + furnace guide</a>; 2-ton ducted vs mini-split is under More matchups.</p>
  <div class="grid">
    {typeComparisons.map((c) => (
      <a class="card" href={`/compare/${c.slug}/`} style="text-decoration:none;color:inherit">
        <div class="small muted">{c.shortLabel}</div>
        <div style="font-weight:700;margin:4px 0;color:var(--acc)">{c.h1}</div>
        <p class="small" style="margin:6px 0">
          <b>{c.left.label}:</b> {usd(c.left.equipMin)}–{usd(c.left.equipMax)} ({c.left.count} systems)<br />
          <b>{c.right.label}:</b> {usd(c.right.equipMin)}–{usd(c.right.equipMax)} ({c.right.count} systems)
        </p>
      </a>
    ))}
  </div>

  <h2>Flagship model-vs-model comparisons ({modelComparisons.length})</h2>
  <p class="small muted">Exact outdoor + indoor model number matchups across 2-ton, 3-ton, 4-ton, and 5-ton heat pumps and mini-splits.</p>
  <div class="grid">
    {modelComparisons.map((c) => (
      <a class="card" href={`/compare/${c.slug}/`} style="text-decoration:none;color:inherit">
        <div class="small muted">{c.shortLabel}</div>
        <div style="font-weight:700;margin:4px 0;color:var(--acc)">{c.h1}</div>
        <p class="small" style="margin:6px 0">
          <b>{c.left.label}:</b> {usd(c.left.equipMin)} · {c.left.seer2Span} · {c.left.refrigerants}<br />
          <b>{c.right.label}:</b> {usd(c.right.equipMin)} · {c.right.seer2Span} · {c.right.refrigerants}
        </p>
      </a>
    ))}
  </div>

  {more.length > 0 && (
    <>
      <h2>More matchups</h2>
      <p class="small muted">{more.map((c, i) => <>{i > 0 && ' · '}<a href={`/compare/${c.slug}/`}>{c.shortLabel}</a></>)}</p>
    </>
  )}

  <Auditor heading="Audit your contractor quote" />
</Base>
