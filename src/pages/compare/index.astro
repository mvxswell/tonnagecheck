---
import Base from '../../layouts/Base.astro';
import CompareWorkbench from '../../components/CompareWorkbench.astro';
import Auditor from '../../components/Auditor.astro';
import { COMPARISONS } from '../../data/comparisons';
import { isCompareMerged, isCompareIndexed } from '../../data/prune';
import { SYSTEMS } from '../../data/equipment';
import { statsOf, usd, seedDateLabel } from '../../lib/facts';

const allStats = statsOf(SYSTEMS)!;
// Featured matchups now live inside guides (301s in public/_redirects). Noindexed template matchups stay listed at the end for visitors.
const live = COMPARISONS.filter((c) => !isCompareMerged(c.slug));
const more = live.filter((c) => !isCompareIndexed(c.slug));
const folded = [
  { href: '/guides/bosch-ids-inverter-heat-pump-cost/', label: 'Bosch vs Mitsubishi', note: 'Bosch IDS inverter cost guide' },
  { href: '/guides/mitsubishi-hyper-heat-cost/', label: 'LG vs Mitsubishi', note: 'Mitsubishi Hyper-Heat guide' },
  { href: '/guides/goodman-vs-trane-vs-carrier-equipment-markup/', label: 'LG vs Trane', note: 'Goodman vs Trane vs Carrier markup guide' },
  { href: '/guides/inverter-vs-single-stage-heat-pump-cost/', label: 'ACiQ vs MRCOOL and inverter vs single-stage', note: 'Inverter vs single-stage guide' },
  { href: '/guides/heat-pump-vs-ac-and-furnace-replacement-cost/', label: 'Heat pump vs AC + furnace, Trane vs Goodman furnaces', note: 'Heat pump vs AC + furnace guide' },
  { href: '/guides/r410a-vs-r454b-r32-refrigerant-transition-quotes/', label: 'R-32 vs R-454B systems', note: 'Refrigerant transition guide' },
  { href: '/guides/2-ton-heat-pump-ac-replacement-cost/', label: '2-ton model matchups (and 1.5-ton listings)', note: '2-ton replacement cost guide' },
  { href: '/guides/3-ton-heat-pump-ac-replacement-cost/', label: '3-ton model matchups', note: '3-ton replacement cost guide' },
  { href: '/guides/4-ton-heat-pump-ac-replacement-cost/', label: '4-ton model matchups', note: '4-ton replacement cost guide' },
  { href: '/guides/5-ton-heat-pump-ac-replacement-cost/', label: '5-ton model matchups', note: '5-ton replacement cost guide' },
];

const title = `${usd(allStats.min)}–${usd(allStats.max)} HVAC Comparison Workbench`;
const description = `Compare HVAC brands, sizes and refrigerants (${usd(allStats.min)}–${usd(allStats.max)} listed equipment vs DOE installed-cost benchmarks). Matchups now live in the guides.`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Head-to-Head HVAC Brand, Tonnage & System Comparisons',
  description,
  url: 'https://tonnagechecker.com/compare/',
};
---
<Base title={title} description={description} jsonld={jsonld}>
  <p class="crumbs"><a href="/">Home</a> / Comparisons</p>
  <h1>Head-to-head HVAC brand, tonnage &amp; system comparisons</h1>
  <p class="lead">Compare public distributor equipment prices ({usd(allStats.min)}–{usd(allStats.max)} across {SYSTEMS.length} systems as of {seedDateLabel}), DOE national-lab installed replacement benchmarks, SEER2/HSPF2 efficiency, refrigerant (R-32 vs R-454B), and contractor markup spreads side by side.</p>

  <CompareWorkbench />

  <h2>Head-to-head matchups, now in the guides</h2>
  <p class="small muted">The brand, refrigerant and flagship model comparisons used to be separate template pages. Each one now sits inside the guide that answers the same question, with the same sourced prices and ratings. Size-by-size cost is on the <a href="/tonnage/">tonnage index</a> (each row opens the size guide).</p>
  <div class="grid">
    {folded.map((f) => (
      <a class="card" href={f.href} style="text-decoration:none;color:inherit">
        <div style="font-weight:700;margin:4px 0;color:var(--acc)">{f.label}</div>
        <div class="small muted">{f.note}</div>
      </a>
    ))}
  </div>

  {more.length > 0 && (
    <>
      <h2>More matchups</h2>
      <p class="small muted">{more.map((c, i) => <>{i > 0 && ' · '}<a href={`/compare/${c.slug}/`}>{c.shortLabel}</a></>)}</p>
    </>
  )}

  <Auditor heading="Audit your contractor quote" />
</Base>
