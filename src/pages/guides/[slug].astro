---
import Base from '../../layouts/Base.astro';
import Auditor from '../../components/Auditor.astro';
import AuditThisQuote from '../../components/AuditThisQuote.astro';
import { NEAR_PAGE1_GUIDES } from '../../data/seo';
import Newsletter from '../../components/Newsletter.astro';
import { GUIDES, type Guide } from '../../data/guides/index';
import { brandByName } from '../../data/brands';
import { tonSlug, lowestPrice } from '../../data/equipment';
import { systemsWhere, usd } from '../../lib/facts';
import { SITE } from '../../config';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const html = g.body();
const words = html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const rel = g.related ?? {};
const relSystems = systemsWhere(rel.systems ?? {}).slice(0, 6);
const relTons = [...new Set([...(rel.tons ?? []), ...relSystems.map((s) => s.tons)])].sort((a, b) => a - b);
const relBrands = [...new Set([...(rel.brands ?? []), ...relSystems.map((s) => s.brand)])].map((b) => brandByName(b)).filter((b) => !!b);
const others = GUIDES.filter((x) => x.slug !== g.slug);
const inCluster = NEAR_PAGE1_GUIDES.some((c) => c.slug === g.slug);
const cluster = inCluster ? NEAR_PAGE1_GUIDES.filter((c) => c.slug !== g.slug) : [];
const topAuditBox = g.slug === 'heat-pump-rebates-and-ahri-certificate-check';
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: g.h1, description: g.description,
    datePublished: g.updated, dateModified: g.updated, wordCount: words,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: `${SITE.url}/guides/${g.slug}/`,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides/` },
      { '@type': 'ListItem', position: 3, name: g.h1, item: `${SITE.url}/guides/${g.slug}/` },
    ],
  },
];
---
<Base title={g.title} description={g.description} jsonld={ld}>
  <p class="crumbs"><a href="/">Home</a> / <a href="/guides/">Guides</a></p>
  <article class="prose">
    <h1>{g.h1}</h1>
    {topAuditBox && <AuditThisQuote systemType={g.audit?.systemType} tons={g.audit?.tons} tier={g.audit?.tier} askModel heading="Audit this quote" lead="Paste the outdoor model number from your quote, the total and your ZIP. We check the price against listed equipment and the installed benchmark." />}
    <p class="small muted">Updated {g.updated} · {Math.max(1, Math.round(words / 230))} min read · Figures are computed from our sourced data at publish time.</p>
    <Fragment set:html={html} />
  </article>

  <aside class="card related" aria-labelledby="rel-h">
    <h2 id="rel-h">Related prices</h2>
    {relTons.length > 0 && <p><b>By size:</b> {relTons.map((t, i) => <>{i > 0 && ' · '}<a href={`/tonnage/${tonSlug(t)}/`}>{t}-ton cost</a></>)}</p>}
    {relBrands.length > 0 && <p><b>By brand:</b> {relBrands.map((b, i) => <>{i > 0 && ' · '}<a href={`/brands/${b!.slug}/`}>{b!.name}</a></>)}</p>}
    {relSystems.length > 0 && (
      <ul class="rs">{relSystems.map((s) => <li><a href={`/systems/${s.slug}/`}>{s.brand} {s.tons}-ton {s.components[0]}</a> <span class="small muted">{s.specs.seer2 ?? '?'} SEER2 · <span class="num">{usd(lowestPrice(s))}</span></span></li>)}</ul>
    )}
    {cluster.length > 0 && <p><b>Related guides:</b> {cluster.map((c, i) => <>{i > 0 && ' · '}<a href={`/guides/${c.slug}/`}>{c.label}</a></>)}</p>}
    <p class="small"><a href="/auditor/">Quote auditor</a> · <a href="/systems/">All equipment prices</a> · <a href="/brands/">All brands</a></p>
  </aside>

  <Auditor systemType={g.audit?.systemType} tons={g.audit?.tons} tier={g.audit?.tier} brand={g.audit?.brand} heading="Have a quote in hand? Grade it" />

  <h2>More guides</h2>
  <ul class="more">{others.map((o) => <li><a href={`/guides/${o.slug}/`}>{o.h1}</a></li>)}</ul>
  <Newsletter />
</Base>

<style>
article :global(.tablewrap){margin:12px 0}
.related{margin-top:28px}
.related h2{margin-top:0;font-size:1.1rem}
.related p{margin:6px 0}
.rs{margin:6px 0;padding-left:18px}
.more{columns:2;column-gap:28px}
.more li{break-inside:avoid;margin:4px 0}
@media (max-width:640px){.more{columns:1}}
</style>
