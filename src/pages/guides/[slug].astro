---
import Base from '../../layouts/Base.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { GUIDES, type Guide } from '../../data/guides/index';
import { brandByName } from '../../data/brands';
import { systemsWhere } from '../../lib/facts';
import { SITE } from '../../config';
import { COMBINED_SIZE_GUIDE_PATH } from '../../data/prune';
import { relatedGuidePicks } from '../../data/guides/related';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const html = g.body();
const words = html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const rel = g.related ?? {};
const relSystems = systemsWhere(rel.systems ?? {}).slice(0, 4);
const relBrands = [...new Set([...(rel.brands ?? []), ...relSystems.map((s) => s.brand)])].map((b) => brandByName(b)).filter((b) => !!b).slice(0, 4);
const related = relatedGuidePicks(g, GUIDES, 5);
const isSizeGuide = g.slug === '3-ton-heat-pump-ac-replacement-cost';
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: g.h1, description: g.description,
    datePublished: g.updated, dateModified: g.updated, wordCount: words,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: `${SITE.url}/guides/${g.slug}/`,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides/` },
      { '@type': 'ListItem', position: 3, name: g.h1, item: `${SITE.url}/guides/${g.slug}/` },
    ],
  },
];
---
<Base title={g.title} description={g.description} jsonld={ld}>
  <p class="crumbs"><a href="/">Home</a> / <a href="/guides/">Guides</a></p>
  <article class="prose">
    <h1>{g.h1}</h1>
    <p class="small muted">Updated {g.updated} · {Math.max(1, Math.round(words / 230))} min read · Figures are computed from our sourced data at publish time.</p>
    <Fragment set:html={html} />
  </article>

  {(related.length > 0 || relBrands.length > 0 || relSystems.length > 0) && (
    <aside class="card related" aria-labelledby="rel-h">
      <h2 id="rel-h">Related reading</h2>
      {related.length > 0 && (
        <ul class="rs">{related.map((o) => <li><a href={`/guides/${o.slug}/`}>{o.h1}</a></li>)}</ul>
      )}
      {!isSizeGuide && <p class="small"><a href={COMBINED_SIZE_GUIDE_PATH}>Replacement cost by size, 1.5 to 5 tons</a></p>}
      {relBrands.length > 0 && <p class="small"><b>Brands:</b> {relBrands.map((b, i) => <>{i > 0 && ' · '}<a href={`/brands/${b!.slug}/`}>{b!.name}</a></>)}</p>}
    </aside>
  )}

  <QuoteCta />
</Base>

<style>
article :global(.tablewrap){margin:12px 0}
.related{margin-top:28px}
.related h2{margin-top:0;font-size:1.1rem}
.related p{margin:6px 0}
.rs{margin:6px 0;padding-left:18px}
</style>
